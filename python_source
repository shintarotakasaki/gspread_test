import streamlit as st
import gspread
from oauth2client.service_account import ServiceAccountCredentials

# Google Sheets APIの認証情報を設定
scope = ["https://spreadsheets.google.com/feeds", "https://www.googleapis.com/auth/drive"]
creds = ServiceAccountCredentials.from_json_keyfile_name("path/to/your/credentials.json", scope)
client = gspread.authorize(creds)

# スプレッドシートを開く
spreadsheet_url = "https://docs.google.com/spreadsheets/d/12hjoNV-0tZaxcFZ3NR5WE8UfbE6FKbWorSKkIRRdj3I/edit?gid=0#gid=0"
sheet = client.open_by_url(spreadsheet_url).worksheet("シート1")

# Streamlitアプリケーション
st.title("Googleスプレッドシート転記アプリ")

if st.button("転記"):
    # A1セルに「gspreadテスト」と書き込む
    sheet.update_cell(1, 1, "gspreadテスト")
    st.success("A1セルに「gspreadテスト」と書き込みました。")
